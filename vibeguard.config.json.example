{
  "enabled": true,
  "debug": false,
  "secrets": {
    "files": ["~/.config/opencode/vibeguard.secrets", ".opencode/vibeguard.secrets"],
    "env": true,
    "opencode_auth": true
  },
  "patterns": {
    "builtin": ["secrets", "iban", "credit_card"],
    "keywords": [{ "value": "Project Bluebird", "category": "CODENAME", "ignore_case": true, "whole_word": true }],
    "regex": [{ "pattern": "ACME-[0-9]{8}", "category": "ACME_ID" }],
    "exclude": ["localhost", "127.0.0.1"],
    "import_deny_paths": false
  },
  "restore": {
    "tools": { "execute": "keep", "webfetch": "ask", "websearch": "deny", "*": "allow" }
  }
}
