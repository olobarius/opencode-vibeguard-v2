{
  "name": "opencode-vibeguard-v2",
  "version": "0.5.0",
  "description": "VibeGuard for OpenCode V2 (2.0.32+): secrets and PII reach the LLM only as __VG_...__ placeholders; real values are restored locally for tools and in the streamed answer",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js",
    "audit.js",
    "command.js",
    "config.js",
    "keepass.js",
    "selftest.js",
    "wincred.js",
    "deep.js",
    "engine.js",
    "guard.js",
    "known.js",
    "patterns.js",
    "policy.js",
    "restore.js",
    "secrets.js",
    "session.js",
    "stream.js",
    "util.js",
    "scripts/sync-deny-paths.mjs",
    "scripts/add-deny-path.mjs",
    "README.md",
    "LICENSE",
    "vibeguard.config.json.example",
    "vibeguard.config.jsonc.example",
    "vibeguard.secrets.example"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vibeguard",
    "privacy",
    "redaction",
