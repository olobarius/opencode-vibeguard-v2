# VibeGuard known-secrets list (dotenv style). Never commit the real file.
# Default locations: ~/.config/opencode/vibeguard.secrets and <project>/.opencode/vibeguard.secrets
#
# NAME=value        -> placeholder __VG_NAME_<hash>__ (stable across sessions/restarts)
# bare line         -> a password or sensitive term, placeholder __VG_SECRET_<hash>__
# Quote values that contain " #" or leading/trailing spaces. `export NAME=...` works too.
# The file is hot-reloaded and protected against `read` by the model.

GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_PASSWORD="correct horse battery staple"
CUSTOMER_NAME="Acme Rocket Corp"
my-old-wifi-password
